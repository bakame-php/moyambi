{
  "name": "bakame/moyambi",
  "type": "library",
  "description": "a lightweight PSR-15 router using URLPattern and UriTemplate for route selection",
  "license": "MIT",
  "homepage" : "https://github.com/bakame-php/moyambi",
  "authors": [
    {
      "name" : "Ignace Nyamagana Butera",
      "email" : "nyamsprod@gmail.com",
      "homepage" : "https://github.com/nyamsprod/",
      "role" : "Developer"
    }
  ],
  "support": {
    "docs": "https://github.com/bakame-php/moyambi",
    "issues": "https://github.com/bakame-php/moyambi/issues",
    "rss": "https://github.com/bakame-php/moyambi/releases.atom",
    "source": "https://github.com/bakame-php/moyambi"
  },
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/nyamsprod"
    }
  ],
  "keywords": [
    "psr15",
    "router",
    "URITemplate",
    "URLPattern",
    "psr17",
    "psr7",
    "api"
  ],
  "require": {
    "php": "^8.4",
    "psr/http-server-middleware": "^1.0.2",
    "psr/http-factory" : "^1.1.0",
    "psr/http-message" : "^2.0",
    "league/uri-interfaces": "dev-master",
    "league/uri": "dev-master"
  },
  "autoload": {
    "psr-4": {
      "Bakame\\Moyambi\\" : "src/"
    }
  },
  "require-dev": {
    "symfony/var-dumper": "^8.1.7",
    "nyholm/psr7": "^1.8.2",
    "nyholm/psr7-server": "^1.1",
    "laminas/laminas-httphandlerrunner": "^2.14",
    "phpstan/phpstan-phpunit": "^2.1.1",
    "phpstan/phpstan": "^2.3",
    "phpunit/phpunit": "^13.4.1",
    "phpstan/phpstan-deprecation-rules": "^2.0.5",
    "friendsofphp/php-cs-fixer": "^3.95.27",
    "phpstan/phpstan-strict-rules": "^2.1"
  },
  "scripts": {
    "phpcs": "php-cs-fixer fix -vvv --diff --dry-run --allow-risky=yes --ansi",
    "phpcs:fix": "php-cs-fixer fix -vvv --allow-risky=yes --ansi",
    "phpstan": "phpstan analyse -c phpstan.neon --ansi --memory-limit=256M",
    "phpunit": "XDEBUG_MODE=coverage phpunit --coverage-text",
    "phpunit:no-coverage": "phpunit --no-coverage",
    "demo": "@php -S localhost:4044 demo/router.php",
    "test": [
      "@phpunit",
      "@phpstan",
      "@phpcs"
    ]
  }
}
